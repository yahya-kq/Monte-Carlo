# Multi-Portfolio Risk Simulator Configuration
APP_NAME="Multi-Portfolio Risk Simulator"
APP_VERSION="1.0.0"
DEBUG=false
API_PREFIX=""
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001", "*"]

# Market Trading Days
TRADING_DAYS_INTERNATIONAL=252
TRADING_DAYS_PSX=250

# Simulation Parameters
DEFAULT_SIMULATIONS=10000
MAX_SIMULATIONS=100000
DEFAULT_CONFIDENCE_LEVEL=0.95
DEFAULT_HORIZON_DAYS=1

# Cache Settings
CACHE_DIR=".cache/market_data"
CACHE_TTL_SECONDS=43200
ENABLE_CACHE=true

# Data Provider Network Settings
HTTP_TIMEOUT_SECONDS=15.0
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=0.5
